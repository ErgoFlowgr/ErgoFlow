{
  "name": "ergoflow",
  "version": "1.0.0",
  "description": "Ergoflow — CRM for handworkers with VAPI AI phone assistant",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "electron:dev": "wait-on http://127.0.0.1:13579 && cross-env NODE_ENV=development node scripts/launch-electron.js",
    "start": "node scripts/start-dev.js",
    "build": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "electron:build": "npm run build && npm run build:electron && electron-builder --win",
    "rebuild": "electron-rebuild -f -w better-sqlite3 keytar",
    "preview": "vite preview"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.36.3",
    "@capacitor/cli": "^7.2.0",
    "@capacitor/core": "^7.2.0",
    "@supabase/supabase-js": "^2.49.1",
    "better-sqlite3": "^11.9.1",
    "i18next": "^25.1.2",
    "keytar": "^7.9.0",
    "pdf-parse": "^1.1.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^15.5.1",
    "react-router-dom": "^7.5.0",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.14.0",
    "@types/pdf-parse": "^1.1.4",
    "@types/react": "^19.1.1",
    "@types/react-dom": "^19.1.2",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.4.1",
    "autoprefixer": "^10.4.21",
    "buffer": "^6.0.3",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^35.7.5",
    "electron-builder": "^25.1.8",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "vite": "^6.3.1",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "com.ergoflow.app",
    "productName": "Ergoflow",
    "directories": {
      "output": "dist-installer"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
