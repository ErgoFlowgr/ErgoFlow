# Copy to .env — used in development only
# In production, all secrets are stored in the OS keychain (Windows Credential Manager)

# Supabase (stored in keychain in prod — these are dev fallbacks)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# VAPI webhook secret (set in Supabase Edge Function environment)
VAPI_WEBHOOK_SECRET=generate-a-random-32-char-string-here
